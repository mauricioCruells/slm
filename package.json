{
  "name": "slm-api-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build && npm run build:example-files",
    "build:example-files": "npx mkdirp dist/example-files && npx cpx \"example-files/*\" \"dist/example-files\" ",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug=0.0.0.0 --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:create": "yarn run typeorm migration:create",
    "migration:generate": "yarn run typeorm migration:generate",
    "migrations": "yarn run typeorm migration:run",
    "migrationsV2": "yarn run typeorm2 migration:run",
    "migration:revert": "yarn run typeorm migration:revert",
    "dev:migration:create": "docker exec -it slm_api_backend yarn run ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli migration:create",
    "dev:migration:generate": "docker exec -it slm_api_backend yarn run typeorm:cli migration:generate",
    "dev:migration:up": "docker exec -it slm_api_backend yarn typeorm:cli migration:run",
    "dev:migration:revert": "docker exec -it slm_api_backend yarn typeorm:cli migration:revert",
    "typeorm:cli": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli -d src/config/data-source.ts",
    "typeorm": "typeorm -d ./dist/config/data-source.js",
    "typeorm2": "typeorm -d ./dist/src/config/data-source.js",
    "test:coverage": "yarn test --coverage --forceExit --detectOpenHandles --maxWorkers=10",
    "test:sonar": "yarn test --coverage --forceExit --detectOpenHandles --maxWorkers=10 --testResultsProcessor --passWithNoTests jest-sonar-reporter",
    "sonar": "node sonar-project.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.312.0",
    "@aws-sdk/s3-request-presigner": "^3.316.0",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/event-emitter": "^1.3.1",
    "@nestjs/jwt": "^10.0.1",
    "@nestjs/passport": "^9.0.0",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/swagger": "^6.1.3",
    "@nestjs/typeorm": "^9.0.1",
    "aws-sdk": "^2.1358.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "joi": "^17.7.0",
    "jsonwebtoken": "^9.0.0",
    "papaparse": "5.3.0",
    "passport": "^0.6.0",
    "passport-azure-ad": "^4.3.4",
    "passport-jwt": "^4.0.1",
    "pg": "^8.8.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "sharp": "^0.32.0",
    "typeorm": "^0.3.10",
    "typeorm-naming-strategies": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@golevelup/ts-jest": "^0.3.5",
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/aws-sdk": "^2.7.0",
    "@types/express": "^4.17.13",
    "@types/jest": "28.1.8",
    "@types/node": "^16.0.0",
    "@types/papaparse": "^5.3.7",
    "@types/passport-azure-ad": "^4.3.1",
    "@types/passport-jwt": "^3.0.8",
    "@types/multer": "^1.4.7",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "28.1.3",
    "jest-sonar-reporter": "^2.0.0",
    "prettier": "^2.3.2",
    "sonarqube-scanner": "^2.8.1",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "28.0.8",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.0",
    "typescript": "^4.7.4"
  }
}
