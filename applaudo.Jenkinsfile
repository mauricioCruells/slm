@Library('Applaudo Studios Library@update-react-pipeline') _
nodeSharePipeline(
    slackChannel: 'slm-backend',
    tagPrefix: 'Web',
    dockerNodeImageVersion: 'node:18-slim',
    createEnvFile: false,
    waitQualityGate: false,
    isDockerized: true,
    isFargate: false,
    isArgo: true,
    needsInjectEnvFile: true,
    runTest: true,
    runMigrations: false
)
